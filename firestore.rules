rules_version = '2';
// ArtMuse: security rules for the shared space.
// Paste this into Firebase console → Firestore Database → Rules, then press "Publish".
service cloud.firestore {
  match /databases/{database}/documents {
    match /spaces/{space} {
      // Only members can read the space. Nobody can list all spaces.
      allow get: if request.auth != null && request.auth.uid in resource.data.members;
      // Starting a space: you are its only member.
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];
      // Members can update it. Someone who knows the space code may add only themselves.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.auth.uid in request.resource.data.members
            && resource.data.members.size() < 20)
      );
      // Works, photos, museums, plans: members only.
      match /{collection}/{id} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/spaces/$(space)).data.members;
      }
    }
  }
}
